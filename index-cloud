<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Laporan Pendapatan</title>

<style>
* {
    box-sizing: border-box;
    font-family: Arial, Helvetica, sans-serif;
}

body {
    margin: 0;
    background: #f3f5f8;
    color: #172033;
}

.container {
    max-width: 1100px;
    margin: 30px auto;
    padding: 20px;
}

.header {
    background: #2563eb;
    color: white;
    padding: 25px;
    border-radius: 15px;
    margin-bottom: 20px;
}

.header h1 {
    margin: 0 0 7px;
    font-size: 28px;
}

.header p {
    margin: 0;
}

.card {
    background: white;
    padding: 22px;
    border-radius: 15px;
    margin-bottom: 20px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.06);
}

.card h2 {
    margin-top: 0;
    margin-bottom: 20px;
}

.form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
}

.form-group {
    display: flex;
    flex-direction: column;
}

label {
    font-size: 14px;
    font-weight: bold;
    margin-bottom: 7px;
}

input,
select {
    width: 100%;
    height: 45px;
    padding: 10px 13px;
    border: 1px solid #cfd5df;
    border-radius: 8px;
    font-size: 14px;
    background: white;
    outline: none;
}

input:focus,
select:focus {
    border-color: #2563eb;
    box-shadow: 0 0 0 2px rgba(37,99,235,0.12);
}

.merchant-info {
    margin-top: 5px;
    font-size: 12px;
    color: #6b7280;
}

.button-area {
    margin-top: 20px;
    display: flex;
    gap: 10px;
}

button {
    border: none;
    border-radius: 8px;
    padding: 12px 20px;
    font-weight: bold;
    cursor: pointer;
}

button:disabled {
    opacity: 0.7;
    cursor: wait;
}

.btn-tambah {
    background: #2563eb;
    color: white;
}

.btn-tambah:hover {
    background: #1d4ed8;
}

.btn-reset {
    background: #e5e7eb;
    color: #374151;
}

.summary-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 15px;
}

.summary {
    border: 1px solid #dfe4eb;
    background: #f8fafc;
    padding: 20px;
    border-radius: 12px;
}

.summary-title {
    font-size: 13px;
    color: #64748b;
    margin-bottom: 8px;
}

.summary-value {
    font-size: 22px;
    font-weight: bold;
    color: #2563eb;
}

.table-wrapper {
    width: 100%;
    overflow-x: auto;
}

table {
    width: 100%;
    border-collapse: collapse;
    min-width: 850px;
}

th {
    background: #f8fafc;
    padding: 13px;
    text-align: left;
    font-size: 13px;
}

td {
    padding: 13px;
    border-bottom: 1px solid #e5e7eb;
    font-size: 14px;
}

.nominal {
    color: #16a34a;
    font-weight: bold;
}

.badge {
    display: inline-block;
    padding: 5px 10px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: bold;
}

.badge-cash {
    background: #dcfce7;
    color: #166534;
}

.badge-transfer {
    background: #dbeafe;
    color: #1e40af;
}

.badge-qris {
    background: #fef3c7;
    color: #92400e;
}

.btn-hapus {
    background: #ef4444;
    color: white;
    padding: 7px 11px;
    font-size: 12px;
}

.empty {
    text-align: center;
    padding: 30px;
    color: #9ca3af;
}

.daily-total {
    font-weight: bold;
    color: #2563eb;
}

@media (max-width: 800px) {
    .summary-grid {
        grid-template-columns: 1fr 1fr;
    }
}

@media (max-width: 600px) {
    .container {
        padding: 12px;
    }

    .form-grid {
        grid-template-columns: 1fr;
    }

    .summary-grid {
        grid-template-columns: 1fr;
    }

    .button-area {
        flex-direction: column;
    }

    button {
        width: 100%;
    }
}
</style>
</head>

<body>

<div class="container">

    <div class="header">
        <h1>📊 Laporan Pendapatan</h1>
        <p>Catat transaksi dan pantau total pendapatan setiap hari.</p>
    </div>


    <!-- INPUT TRANSAKSI -->

    <div class="card">

        <h2>➕ Tambah Transaksi</h2>

        <div class="form-grid">

            <div class="form-group">
                <label for="tanggal">Tanggal</label>
                <input type="date" id="tanggal">
            </div>


            <div class="form-group">
                <label for="jam">Jam</label>
                <input type="time" id="jam">
            </div>


            <div class="form-group">
                <label for="nominal">Nominal</label>

                <input
                    type="text"
                    id="nominal"
                    placeholder="Contoh: 50.000 atau 50000"
                    inputmode="numeric"
                    autocomplete="off"
                >
            </div>


            <div class="form-group">
                <label for="metode">Metode Pembayaran</label>

                <select id="metode">

                    <option value="">
                        -- Pilih Metode --
                    </option>

                    <option value="Cash">
                        Cash
                    </option>

                    <option value="Transfer">
                        Transfer
                    </option>

                    <option value="QRIS">
                        QRIS
                    </option>

                </select>
            </div>


            <div class="form-group">

                <label for="merchant">
                    Nama Merchant QRIS
                </label>

                <input
                    type="text"
                    id="merchant"
                    placeholder="Ketik nama merchant..."
                    autocomplete="off"
                >

                <div class="merchant-info">
                    Isi nama merchant sesuai transaksi.
                    Wajib diisi jika metode QRIS.
                </div>

            </div>

        </div>


        <div class="button-area">

            <button
                type="button"
                id="btnTambah"
                class="btn-tambah"
            >
                + Tambah Transaksi
            </button>


            <button
                type="button"
                id="btnReset"
                class="btn-reset"
            >
                Reset
            </button>

        </div>

    </div>


    <!-- RINGKASAN -->

    <div class="card">

        <h2>📈 Ringkasan Pendapatan</h2>

        <div class="summary-grid">

            <div class="summary">

                <div class="summary-title">
                    Total Pendapatan
                </div>

                <div
                    class="summary-value"
                    id="totalKeseluruhan"
                >
                    Rp0
                </div>

            </div>


            <div class="summary">

                <div class="summary-title">
                    Cash
                </div>

                <div
                    class="summary-value"
                    id="totalCash"
                >
                    Rp0
                </div>

            </div>


            <div class="summary">

                <div class="summary-title">
                    Transfer
                </div>

                <div
                    class="summary-value"
                    id="totalTransfer"
                >
                    Rp0
                </div>

            </div>


            <div class="summary">

                <div class="summary-title">
                    QRIS
                </div>

                <div
                    class="summary-value"
                    id="totalQris"
                >
                    Rp0
                </div>

            </div>

        </div>

    </div>


    <!-- DATA TRANSAKSI -->

    <div class="card">

        <h2>📋 Data Transaksi</h2>

        <div class="table-wrapper">

            <table>

                <thead>

                    <tr>

                        <th>No</th>
                        <th>Tanggal</th>
                        <th>Jam</th>
                        <th>Nominal</th>
                        <th>Metode</th>
                        <th>Merchant QRIS</th>
                        <th>Aksi</th>

                    </tr>

                </thead>

                <tbody id="tabelPendapatan"></tbody>

            </table>

        </div>

    </div>


    <!-- TOTAL PER HARI -->

    <div class="card">

        <h2>📅 Total Pendapatan Per Hari</h2>

        <div class="table-wrapper">

            <table>

                <thead>

                    <tr>

                        <th>Tanggal</th>
                        <th>Jumlah Transaksi</th>
                        <th>Total Pendapatan</th>

                    </tr>

                </thead>

                <tbody id="totalHarian"></tbody>

            </table>

        </div>

    </div>

</div>


<script>

/* ==========================================
   URL GOOGLE APPS SCRIPT KAMU
========================================== */

const API_URL =
"https://script.google.com/macros/s/AKfycbw0vx-9veTidnxjefcw-iijI73y_PdPuYE0AV3zEw63tTBkatdd2-GduCELcNxCqnN5/exec";


let dataPendapatan = [];


/* ==========================================
   ELEMENT
========================================== */

const tanggalInput =
    document.getElementById("tanggal");

const jamInput =
    document.getElementById("jam");

const nominalInput =
    document.getElementById("nominal");

const metodeInput =
    document.getElementById("metode");

const merchantInput =
    document.getElementById("merchant");

const btnTambah =
    document.getElementById("btnTambah");

const btnReset =
    document.getElementById("btnReset");


/* ==========================================
   FORMAT RUPIAH
========================================== */

function formatRupiah(angka) {

    return new Intl.NumberFormat(
        "id-ID",
        {
            style: "currency",
            currency: "IDR",
            maximumFractionDigits: 0
        }
    ).format(Number(angka) || 0);

}


/* ==========================================
   FORMAT TANGGAL
========================================== */

function formatTanggal(tanggal) {

    const date =
        new Date(tanggal + "T00:00:00");

    return date.toLocaleDateString(
        "id-ID",
        {
            day: "2-digit",
            month: "2-digit",
            year: "numeric"
        }
    );

}


/* ==========================================
   AMANKAN HTML
========================================== */

function escapeHTML(text) {

    return String(text ?? "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");

}


/* ==========================================
   REQUEST KE GOOGLE APPS SCRIPT
========================================== */

async function apiRequest(data) {

    const response =
        await fetch(
            API_URL,
            {
                method: "POST",

                headers: {
                    "Content-Type":
                        "text/plain;charset=utf-8"
                },

                body: JSON.stringify(data)
            }
        );


    if (!response.ok) {

        throw new Error(
            "HTTP " + response.status
        );

    }


    const result =
        await response.json();


    if (!result.success) {

        throw new Error(
            result.message ||
            "Terjadi kesalahan."
        );

    }


    return result;

}


/* ==========================================
   AMBIL DATA DARI GOOGLE SHEETS
========================================== */

async function ambilDataDariSheet() {

    try {

        const result =
            await apiRequest({
                action: "ambil"
            });


        dataPendapatan =
            Array.isArray(result.data)
                ? result.data
                : [];


        dataPendapatan.sort(
            function(a, b) {

                if (
                    a.tanggal !==
                    b.tanggal
                ) {

                    return String(
                        a.tanggal
                    ).localeCompare(
                        String(b.tanggal)
                    );

                }


                return String(
                    a.jam
                ).localeCompare(
                    String(b.jam)
                );

            }
        );


        tampilkanData();


    } catch (error) {

        console.error(error);

        alert(
            "Gagal mengambil data dari Google Sheets.\n\n" +
            error.message
        );

    }

}


/* ==========================================
   FORMAT NOMINAL SAAT DIKETIK
========================================== */

nominalInput.addEventListener(
    "input",
    function() {

        let angka =
            this.value.replace(
                /\D/g,
                ""
            );


        if (angka === "") {

            this.value = "";

            return;

        }


        this.value =
            Number(
                angka
            ).toLocaleString(
                "id-ID"
            );

    }
);


/* ==========================================
   TAMBAH TRANSAKSI
========================================== */

async function tambahTransaksi() {

    const tanggal =
        tanggalInput.value;

    const jam =
        jamInput.value;

    const nominalText =
        nominalInput.value;

    const metode =
        metodeInput.value;

    const merchant =
        merchantInput.value.trim();


    const nominal =
        Number(
            nominalText.replace(
                /\D/g,
                ""
            )
        );


    if (!tanggal) {

        alert(
            "Tanggal wajib diisi."
        );

        tanggalInput.focus();

        return;

    }


    if (!jam) {

        alert(
            "Jam wajib diisi."
        );

        jamInput.focus();

        return;

    }


    if (
        !nominal ||
        nominal <= 0
    ) {

        alert(
            "Nominal wajib diisi."
        );

        nominalInput.focus();

        return;

    }


    if (!metode) {

        alert(
            "Silakan pilih metode pembayaran."
        );

        metodeInput.focus();

        return;

    }


    if (
        metode === "QRIS" &&
        merchant === ""
    ) {

        alert(
            "Nama Merchant QRIS wajib diisi."
        );

        merchantInput.focus();

        return;

    }


    btnTambah.disabled =
        true;

    btnTambah.textContent =
        "Menyimpan...";


    try {

        await apiRequest({

            action: "tambah",

            tanggal:
                tanggal,

            jam:
                jam,

            nominal:
                nominal,

            metode:
                metode,

            merchant:
                merchant

        });


        nominalInput.value =
            "";

        merchantInput.value =
            "";


        await ambilDataDariSheet();


        nominalInput.focus();


    } catch (error) {

        console.error(error);

        alert(
            "Gagal menyimpan transaksi.\n\n" +
            error.message
        );


    } finally {

        btnTambah.disabled =
            false;

        btnTambah.textContent =
            "+ Tambah Transaksi";

    }

}


/* ==========================================
   TOMBOL TAMBAH
========================================== */

btnTambah.addEventListener(
    "click",
    tambahTransaksi
);


/* ==========================================
   ENTER
========================================== */

merchantInput.addEventListener(
    "keydown",
    function(event) {

        if (
            event.key ===
            "Enter"
        ) {

            event.preventDefault();

            tambahTransaksi();

        }

    }
);


/* ==========================================
   RESET
========================================== */

function resetForm() {

    nominalInput.value =
        "";

    merchantInput.value =
        "";

    metodeInput.value =
        "";

    nominalInput.focus();

}


btnReset.addEventListener(
    "click",
    resetForm
);


/* ==========================================
   TAMPILKAN DATA
========================================== */

function tampilkanData() {

    const tabel =
        document.getElementById(
            "tabelPendapatan"
        );


    tabel.innerHTML = "";


    if (
        dataPendapatan.length ===
        0
    ) {

        tabel.innerHTML = `
            <tr>
                <td
                    colspan="7"
                    class="empty"
                >
                    Belum ada transaksi.
                </td>
            </tr>
        `;

    } else {

        dataPendapatan.forEach(
            function(data, index) {

                let badgeClass =
                    "badge-qris";


                if (
                    data.metode ===
                    "Cash"
                ) {

                    badgeClass =
                        "badge-cash";

                }


                if (
                    data.metode ===
                    "Transfer"
                ) {

                    badgeClass =
                        "badge-transfer";

                }


                const row =
                    document.createElement(
                        "tr"
                    );


                row.innerHTML = `

                    <td>
                        ${index + 1}
                    </td>

                    <td>
                        ${formatTanggal(
                            data.tanggal
                        )}
                    </td>

                    <td>
                        ${escapeHTML(
                            data.jam
                        )}
                    </td>

                    <td class="nominal">
                        ${formatRupiah(
                            data.nominal
                        )}
                    </td>

                    <td>

                        <span
                            class="badge ${badgeClass}"
                        >
                            ${escapeHTML(
                                data.metode
                            )}
                        </span>

                    </td>

                    <td>
                        ${
                            data.merchant
                                ? escapeHTML(
                                    data.merchant
                                )
                                : "-"
                        }
                    </td>

                    <td>

                        <button
                            type="button"
                            class="btn-hapus"
                        >
                            Hapus
                        </button>

                    </td>

                `;


                row
                    .querySelector(
                        ".btn-hapus"
                    )
                    .addEventListener(
                        "click",
                        function() {

                            hapusTransaksi(
                                data.id
                            );

                        }
                    );


                tabel.appendChild(
                    row
                );

            }
        );

    }


    hitungRingkasan();

    tampilkanTotalHarian();

}


/* ==========================================
   HAPUS TRANSAKSI
========================================== */

async function hapusTransaksi(id) {

    const yakin =
        confirm(
            "Hapus transaksi ini?"
        );


    if (!yakin) {

        return;

    }


    try {

        await apiRequest({

            action:
                "hapus",

            id:
                id

        });


        await ambilDataDariSheet();


    } catch (error) {

        console.error(error);

        alert(
            "Gagal menghapus transaksi.\n\n" +
            error.message
        );

    }

}


/* ==========================================
   RINGKASAN
========================================== */

function hitungRingkasan() {

    let total = 0;

    let cash = 0;

    let transfer = 0;

    let qris = 0;


    dataPendapatan.forEach(
        function(data) {

            const nominal =
                Number(
                    data.nominal
                ) || 0;


            total +=
                nominal;


            if (
                data.metode ===
                "Cash"
            ) {

                cash +=
                    nominal;

            }


            if (
                data.metode ===
                "Transfer"
            ) {

                transfer +=
                    nominal;

            }


            if (
                data.metode ===
                "QRIS"
            ) {

                qris +=
                    nominal;

            }

        }
    );


    document.getElementById(
        "totalKeseluruhan"
    ).textContent =
        formatRupiah(total);


    document.getElementById(
        "totalCash"
    ).textContent =
        formatRupiah(cash);


    document.getElementById(
        "totalTransfer"
    ).textContent =
        formatRupiah(transfer);


    document.getElementById(
        "totalQris"
    ).textContent =
        formatRupiah(qris);

}


/* ==========================================
   TOTAL PER HARI
========================================== */

function tampilkanTotalHarian() {

    const harian = {};


    dataPendapatan.forEach(
        function(data) {

            if (
                !harian[
                    data.tanggal
                ]
            ) {

                harian[
                    data.tanggal
                ] = {

                    jumlah: 0,

                    total: 0

                };

            }


            harian[
                data.tanggal
            ].jumlah += 1;


            harian[
                data.tanggal
            ].total +=
                Number(
                    data.nominal
                ) || 0;

        }
    );


    const tabel =
        document.getElementById(
            "totalHarian"
        );


    tabel.innerHTML =
        "";


    const tanggalList =
        Object.keys(
            harian
        ).sort();


    if (
        tanggalList.length ===
        0
    ) {

        tabel.innerHTML = `
            <tr>
                <td
                    colspan="3"
                    class="empty"
                >
                    Belum ada data.
                </td>
            </tr>
        `;

        return;

    }


    tanggalList.forEach(
        function(tanggal) {

            const row =
                document.createElement(
                    "tr"
                );


            row.innerHTML = `

                <td>
                    ${formatTanggal(
                        tanggal
                    )}
                </td>

                <td>
                    ${
                        harian[
                            tanggal
                        ].jumlah
                    }
                    transaksi
                </td>

                <td class="daily-total">
                    ${formatRupiah(
                        harian[
                            tanggal
                        ].total
                    )}
                </td>

            `;


            tabel.appendChild(
                row
            );

        }
    );

}


/* ==========================================
   TANGGAL & JAM OTOMATIS
========================================== */

function setTanggalJam() {

    const sekarang =
        new Date();


    const tahun =
        sekarang.getFullYear();


    const bulan =
        String(
            sekarang.getMonth() + 1
        ).padStart(
            2,
            "0"
        );


    const hari =
        String(
            sekarang.getDate()
        ).padStart(
            2,
            "0"
        );


    const jam =
        String(
            sekarang.getHours()
        ).padStart(
            2,
            "0"
        );


    const menit =
        String(
            sekarang.getMinutes()
        ).padStart(
            2,
            "0"
        );


    tanggalInput.value =
        `${tahun}-${bulan}-${hari}`;


    jamInput.value =
        `${jam}:${menit}`;

}


/* ==========================================
   JALANKAN
========================================== */

setTanggalJam();

ambilDataDariSheet();

</script>
